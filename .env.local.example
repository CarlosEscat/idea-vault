# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Used by the demo sign-in route and the seed/migration scripts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Encryption — 32+ random characters. Changing it makes existing data unreadable.
# Run: openssl rand -base64 32
ENCRYPTION_SECRET=your_strong_random_secret_here

# App (public URL of this deployment, e.g. https://idea-vault.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — read-only demo vault ("Try the demo"). Created by `npm run seed:demo`, which prints DEMO_USER_ID.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_ID=
# Only for `npm run seed:demo` (pre-computes the demo embeddings; not needed at runtime)
SEED_EMBEDDINGS_PROVIDER=openai
SEED_EMBEDDINGS_MODEL=text-embedding-3-small
SEED_EMBEDDINGS_API_KEY=

# Optional — self-hosting only: allow Ollama/base URLs on private addresses in production builds
# ALLOW_PRIVATE_LLM_URLS=true
